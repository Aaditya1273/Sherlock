# Sherlock — environment
#
# Backend variables go in the CONVEX deployment, not in this file:
#   npx convex env set OPENAI_API_KEY sk-...
# This file documents what exists and is the template for the two frontend
# values Vite needs locally. Never commit real keys.

# ---------------------------------------------------------------- frontend --
# Local development only. In production the frontend is served by the same
# Convex deployment and derives this automatically.
VITE_CONVEX_URL=

# ----------------------------------------------------------------- required --
# Set these with `npx convex env set <NAME> <value>`.

# OpenAI — extraction, evidence reasoning, claim drafting, reply analysis.
# Without it, investigations stop at PARSING with a readable failure.
OPENAI_API_KEY=

# Firecrawl — policy and price research. Without it, cases fail at the
# INVESTIGATING stage rather than proceeding with no evidence.
FIRECRAWL_API_KEY=

# AgentMail — the inbox. Needed to create an inbox and to send claims.
AGENTMAIL_API_KEY=

# Shared secret for the inbound webhook. Set the SAME value in the AgentMail
# webhook configuration. Sherlock rejects deliveries that do not match, and
# refuses inbound mail entirely while this is unset.
AGENTMAIL_WEBHOOK_SECRET=

# Owner passcode, stored as a salted SHA-256 hash — never the passphrase.
# Generate it from Settings while the deployment is still in open mode.
# Until this is set Sherlock runs open (anyone who can reach the deployment can
# read your cases) and OUTBOUND EMAIL IS DISABLED.
SHERLOCK_PASSCODE_HASH=

# ----------------------------------------------------------------- optional --

# Random string mixed into the passcode hash. Set it BEFORE generating the
# hash above. Defaults to a fixed value if unset.
SHERLOCK_PASSCODE_SALT=

# Override the OpenAI model. Must support strict structured outputs.
# Default: gpt-4o-mini
OPENAI_MODEL=
