{
  "name": "sherlock",
  "version": "1.0.0",
  "description": "Sherlock — Give Your Inbox a Browser. An email-native AI agent that investigates the web, builds evidence, and helps you act.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:backend": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "convex codegen",
    "deploy": "static-hosting deploy --dist ./out --component selfStaticHosting --build-command \"npm run build\"",
    "upload": "static-hosting upload --dist ./out --component selfStaticHosting"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/self-static-hosting": "github:get-convex/self-static-hosting",
    "convex": "^1.31.7",
    "next": "^16.3.5",
    "ogl": "^1.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.5"
  },
  "license": "MIT"
}
